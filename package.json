{
  "name": "tara-ptv",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "TARA Personal Transportation Vehicles — 100% static site for GitHub Pages",
  "scripts": {
    "dev": "npm run build:data && vite",
    "build:data": "tsx script/fetch-data.ts && tsx script/generate-seo.ts && tsx script/optimize-assets.ts",
    "build": "tsx script/fetch-data.ts && tsx script/generate-seo.ts && tsx script/optimize-assets.ts && vite build && tsx script/prerender.ts",
    "build:site": "cross-env SKIP_REMOTE_FETCH=1 npm run build",
    "preview": "tsx script/serve-dist.ts",
    "verify": "tsx script/verify.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist public .cache/images",
    "compress:sources": "tsx script/compress-sources.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cross-env": "^7.0.3",
    "html-minifier-terser": "^7.2.0",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.3",
    "svgo": "^3.3.2",
    "terser": "^5.44.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
