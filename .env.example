# Where the site is served from.
#   "/"              custom domain, or https://<user>.github.io
#   "/<repo-name>/"  project site, e.g. https://<user>.github.io/tara-ptv/
BASE_PATH=/

# Bare domain used for canonical URLs, sitemap.xml, OG tags and the CNAME file.
SITE_DOMAIN=taraptv.com

# Third-party form endpoint (Formspree). Public by design — it is called from
# the browser. Leave empty and the contact form falls back to a mailto: link.
FORMSPREE_ENDPOINT=

# Optional live-inventory enrichment, read ONLY by script/fetch-data.ts.
# The key never reaches the client bundle.
INVENTORY_API_URL=
INVENTORY_API_KEY=

# Emit AVIF alongside WebP. Off by default: serving AVIF needs a <picture>
# wrapper, and the mirrored stylesheet has `a>img` direct-child rules that a
# wrapper would break.
ENABLE_AVIF=0
